<?xml version="1.0" encoding="utf-8"?>
<!-- En Android 12 o superior el respaldo se configura aquí y no con allowBackup. No se respalda nada: el modo puerta
     guarda un token de 7 días y Room guarda una copia de reservas y pagos, y ninguno debe salir del teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
